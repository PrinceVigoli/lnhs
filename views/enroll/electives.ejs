<%- include('../partials/head',{title:'Choose Electives'}) %><%- include('../partials/nav') %>
<div class="container"><div class="page-header"><div><span class="eyebrow-label"><%=strand%> curriculum</span><h4>Build your elective plan</h4><p>Select up to 10 subjects, then assign each a unique priority rank.</p></div><a class="btn btn-light border" href="/enroll/results"><i class="bi bi-arrow-left me-1"></i>Change strand</a></div><%- include('_steps',{current:4}) %>
<%if(typeof error!=='undefined'){%><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%=error%></div><%}%>
<form method="post" action="/enroll/submit"><div class="elective-toolbar"><span class="elective-count" id="electiveCount">0 of 10 selected</span><div class="elective-search input-icon-wrap"><i class="bi bi-search input-icon"></i><input class="form-control" id="electiveSearch" type="search" placeholder="Search subjects or clusters…"></div><button class="btn btn-success d-none d-md-inline-flex"><i class="bi bi-send-check me-1"></i>Submit enrollment</button></div>
<div class="elective-list"><%let previous=''; electives.forEach(e=>{if(previous!==e.cluster){previous=e.cluster;%><div class="cluster-header"><span><i class="bi bi-collection me-2"></i><%=e.cluster%></span><span class="badge rounded-pill text-bg-light"><%=e.track%></span></div><%}%><div class="pos-elective-card mb-2"><div class="row align-items-center g-3"><div class="col"><label class="d-flex align-items-center gap-3 m-0"><input class="form-check-input elective-check" type="checkbox" name="electives" value="<%=e.key%>"><span><strong><%=e.name%></strong><small class="d-block text-muted"><i class="bi bi-clock me-1"></i><%=e.hours%> hours</small></span></label></div><div class="col-auto"><label class="rank-field"><span>Priority</span><input class="form-control form-control-sm rank-input" type="number" name="ranks[<%=e.key%>]" min="1" max="10" placeholder="—" disabled></label></div></div></div><%})%></div><div class="mobile-submit"><span id="mobileElectiveHint">Review your selections and ranks.</span><button class="btn btn-success"><i class="bi bi-send-check me-1"></i>Submit enrollment</button></div></form></div><%- include('../partials/foot') %>
