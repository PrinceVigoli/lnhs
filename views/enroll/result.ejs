<%- include('../partials/head',{title:'Enrollment Result'}) %><%- include('../partials/nav') %>
<div class="container py-4"><div class="page-header"><div><h4><i class="bi bi-check-circle me-2"></i>Enrollment Submitted</h4><p class="text-muted mb-0">Reference #<%=String(enrollment.id).padStart(6,'0')%></p></div><span class="status-badge status-<%=enrollment.status%>"><%=enrollment.status%></span></div>
<div class="row g-4"><div class="col-md-7"><div class="card"><div class="card-section-header"><i class="bi bi-journal-check text-primary"></i>Enrollment Details</div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-5">School Year</dt><dd class="col-sm-7"><%=enrollment.school_year%></dd><dt class="col-sm-5">Grade / Semester</dt><dd class="col-sm-7"><%=enrollment.grade_level%> / <%=enrollment.semester%></dd><dt class="col-sm-5">RIASEC Recommendation</dt><dd class="col-sm-7"><span class="strand-badge strand-<%=enrollment.recommended_strand%>"><%=enrollment.recommended_strand%></span></dd><dt class="col-sm-5">Chosen Strand</dt><dd class="col-sm-7"><span class="strand-badge strand-<%=enrollment.chosen_strand%>"><%=enrollment.chosen_strand%></span></dd></dl></div></div></div><div class="col-md-5"><div class="card"><div class="card-section-header"><i class="bi bi-printer text-primary"></i>Print Forms</div><div class="card-body"><a class="btn btn-primary w-100" href="/print/enrollment/<%=enrollment.id%>" target="_blank"><i class="bi bi-file-earmark-text me-2"></i>Enrollment Form</a><a class="btn btn-outline-primary w-100 mt-2" href="/print/plan-of-study/<%=enrollment.id%>" target="_blank"><i class="bi bi-list-ol me-2"></i>Plan of Study</a><a class="btn btn-outline-secondary w-100 mt-2" href="/dashboard">Return to Dashboard</a></div></div></div></div></div><%- include('../partials/foot') %>
