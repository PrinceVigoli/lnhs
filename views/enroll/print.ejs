<% const marked = value => value ? 'checked' : ''; %>
<% const text = value => value ?? ''; %>
<% const dateValue = row.birth_date ? new Date(row.birth_date) : null; %>
<% const birthDate = dateValue && !Number.isNaN(dateValue.valueOf()) ? dateValue.toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'}) : ''; %>
<% const age = dateValue && !Number.isNaN(dateValue.valueOf()) ? Math.max(0,new Date().getFullYear()-dateValue.getFullYear()-((new Date().getMonth()<dateValue.getMonth()||(new Date().getMonth()===dateValue.getMonth()&&new Date().getDate()<dateValue.getDate()))?1:0)) : ''; %>
<% const currentAddress = [row.cur_house_no,row.cur_street,row.cur_barangay,row.cur_municipality,row.cur_province,row.cur_country,row.cur_zip].filter(Boolean).join(', ') || row.address || ''; %>
<% const permanentAddress = row.perm_same_as_current ? currentAddress : [row.perm_house_no,row.perm_street,row.perm_barangay,row.perm_municipality,row.perm_province,row.perm_country,row.perm_zip].filter(Boolean).join(', '); %>
<% const strand = row.admin_strand_override || row.chosen_strand || ''; %>
<% const modes = Array.isArray(row.dl_modalities) ? row.dl_modalities : []; %>
<% const manifestations = Array.isArray(row.sne_manifestations) ? row.sne_manifestations : []; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Basic Education Enrollment Form - <%=text(row.last_name)%>, <%=text(row.first_name)%></title>
  <style>
    *{box-sizing:border-box} @page{size:A4 portrait;margin:7mm} body{margin:0;background:#e7ebf0;color:#111;font-family:Arial,Helvetica,sans-serif}.toolbar{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:10px 18px;background:#102a4f;color:#fff;box-shadow:0 2px 8px #0003}.toolbar div{display:flex;gap:8px}.toolbar a,.toolbar button{border:1px solid #ffffff55;border-radius:6px;padding:8px 14px;background:#fff;color:#102a4f;font:700 13px Arial,Helvetica,sans-serif;text-decoration:none;cursor:pointer}.toolbar .secondary{background:transparent;color:#fff}.sheet{width:210mm;min-height:297mm;margin:12px auto;padding:7mm;background:#fff;box-shadow:0 2px 15px #0002;page-break-after:always}.sheet:last-child{page-break-after:auto}.form-title{text-align:center;margin-bottom:7px}.form-title h1{margin:0;font-size:18px;letter-spacing:.02em}.form-title p{margin:2px 0;font-size:9px;font-weight:700}.revision{text-align:right;font-size:8px;font-weight:700}.instruction{margin:7px 0;font-size:8px;font-style:italic;line-height:1.35}.section-title{margin-top:6px;padding:3px 5px;border:1px solid #111;background:#e8e8e8;font-size:9px;font-weight:800;text-transform:uppercase}.grid{width:100%;border-collapse:collapse;table-layout:fixed}.grid th,.grid td{border:1px solid #111;padding:3px 4px;vertical-align:top;font-size:8px;line-height:1.25}.grid th{font-weight:700;text-align:left;background:#f4f4f4}.label{display:block;margin-bottom:2px;font-size:6.5px;font-weight:700;text-transform:uppercase;color:#333}.value{min-height:12px;font-size:9px;font-weight:600}.boxes{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.box{display:inline-grid;width:12px;height:12px;margin-right:3px;border:1px solid #111;place-items:center;font-size:10px;font-weight:900;line-height:1;vertical-align:-2px}.box.checked{background:#111;color:#fff}.certification{margin:12px 3px 0;font-size:8px;line-height:1.45;text-align:justify}.signatures{display:grid;grid-template-columns:1fr 150px;gap:45px;margin-top:34px;text-align:center;font-size:8px}.signature-line{border-top:1px solid #111;padding-top:3px}.brandline{font-size:8px;text-align:center;margin-bottom:4px}.page-label{text-align:right;font-size:7px;color:#555;margin-top:4px}@media print{body{background:#fff}.toolbar{display:none}.sheet{width:auto;min-height:auto;margin:0;padding:0;box-shadow:none}.section-title,.grid th{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
  </style>
</head>
<body>
  <div class="toolbar"><strong>Basic Education Enrollment Form</strong><div><a class="secondary" href="<%=user.role==='student'?'/result/'+row.enrollment_id:'/admin/enrollments'%>">Back</a><button id="printButton">Print form</button></div></div>

  <section class="sheet">
    <div class="revision">Revised as of 06/01/2025</div>
    <div class="form-title"><div class="brandline">LUNA NATIONAL HIGH SCHOOL</div><h1>BASIC EDUCATION ENROLLMENT FORM</h1><p>THIS FORM IS NOT FOR SALE</p></div>
    <p class="instruction">Complete the required information and check all appropriate boxes. Review the information before printing and signing this form.</p>
    <table class="grid">
      <tr><td><span class="label">1. School Year</span><div class="value"><%=text(row.school_year)%></div></td><td><span class="label">Enrollment Reference</span><div class="value">#<%=String(row.enrollment_id).padStart(6,'0')%></div></td><td colspan="2"><span class="label">Learner Reference No. (LRN), if applicable</span><div class="value"><%=text(row.lrn)%></div></td></tr>
      <tr><td><span class="label">2. Grade Level to Enroll</span><div class="value">Grade <%=text(row.grade_level)%></div></td><td><span class="label">Semester</span><div class="value"><%=text(row.semester)%></div></td><td><span class="label">Application Status</span><div class="value"><%=text(row.status)%></div></td><td><span class="label">Date Submitted</span><div class="value"><%=row.created_at?new Date(row.created_at).toLocaleDateString('en-US'):''%></div></td></tr>
    </table>
    <div class="section-title">3. Learner's Personal Information</div>
    <table class="grid">
      <tr><td colspan="3"><span class="label">PSA Birth Certificate No. (if available)</span><div class="value"><%=text(row.psa_birth_cert_no)%></div></td><td><span class="label">Birthdate (mm/dd/yyyy)</span><div class="value"><%=birthDate%></div></td></tr>
      <tr><td><span class="label">Last Name</span><div class="value"><%=text(row.last_name)%></div></td><td><span class="label">First Name</span><div class="value"><%=text(row.first_name)%></div></td><td><span class="label">Middle Name</span><div class="value"><%=text(row.middle_name)%></div></td><td><span class="label">Extension Name</span><div class="value"><%=text(row.extension_name)%></div></td></tr>
      <tr><td><span class="label">Age</span><div class="value"><%=age%></div></td><td><span class="label">Sex</span><div class="value boxes"><span><span class="box <%=marked(String(row.gender).toLowerCase()==='male')%>"><%=String(row.gender).toLowerCase()==='male'?'✓':''%></span>Male</span><span><span class="box <%=marked(String(row.gender).toLowerCase()==='female')%>"><%=String(row.gender).toLowerCase()==='female'?'✓':''%></span>Female</span></div></td><td><span class="label">Place of Birth</span><div class="value"><%=text(row.place_of_birth)%></div></td><td><span class="label">Nationality</span><div class="value"><%=text(row.nationality)%></div></td></tr>
      <tr><td colspan="2"><span class="label">Religion</span><div class="value"><%=text(row.religion)%></div></td><td><span class="label">Mother Tongue</span><div class="value"><%=text(row.mother_tongue)%></div></td><td><span class="label">Contact Number</span><div class="value"><%=text(row.contact_number)%></div></td></tr>
      <tr><td colspan="2"><span class="label">Belonging to an Indigenous Peoples Community?</span><div class="value boxes"><span><span class="box <%=marked(row.is_ip)%>"><%=row.is_ip?'✓':''%></span>Yes</span><span><span class="box <%=marked(!row.is_ip)%>"><%=!row.is_ip?'✓':''%></span>No</span><span>If yes: <%=text(row.ip_community)%></span></div></td><td colspan="2"><span class="label">Is the family a beneficiary of 4Ps?</span><div class="value boxes"><span><span class="box <%=marked(row.is_4ps)%>"><%=row.is_4ps?'✓':''%></span>Yes</span><span><span class="box <%=marked(!row.is_4ps)%>"><%=!row.is_4ps?'✓':''%></span>No</span><span>Household ID: <%=text(row.fourps_household_id)%></span></div></td></tr>
    </table>
    <div class="section-title">Current Address</div>
    <table class="grid"><tr><td><span class="label">House No.</span><div class="value"><%=text(row.cur_house_no)%></div></td><td colspan="2"><span class="label">Sitio / Street Name</span><div class="value"><%=text(row.cur_street)%></div></td><td><span class="label">Barangay</span><div class="value"><%=text(row.cur_barangay)%></div></td></tr><tr><td><span class="label">Municipality / City</span><div class="value"><%=text(row.cur_municipality)%></div></td><td><span class="label">Province</span><div class="value"><%=text(row.cur_province)%></div></td><td><span class="label">Country</span><div class="value"><%=text(row.cur_country)%></div></td><td><span class="label">ZIP Code</span><div class="value"><%=text(row.cur_zip)%></div></td></tr><tr><td colspan="4"><span class="label">Full Address</span><div class="value"><%=currentAddress%></div></td></tr></table>
    <div class="section-title">Permanent Address</div>
    <table class="grid"><tr><td colspan="4"><span class="label">Same as Current Address?</span><div class="value boxes"><span><span class="box <%=marked(row.perm_same_as_current)%>"><%=row.perm_same_as_current?'✓':''%></span>Yes</span><span><span class="box <%=marked(!row.perm_same_as_current)%>"><%=!row.perm_same_as_current?'✓':''%></span>No</span></div></td></tr><tr><td colspan="4"><span class="label">Permanent Address</span><div class="value"><%=permanentAddress%></div></td></tr></table>
    <div class="section-title">4. Parent's / Guardian's Information</div>
    <table class="grid"><tr><th>Relationship</th><th>Last Name</th><th>First Name</th><th>Middle Name</th><th>Contact Number</th></tr><tr><td>Father</td><td><%=text(row.father_last)%></td><td><%=text(row.father_first)%></td><td><%=text(row.father_middle)%></td><td><%=text(row.father_contact)%></td></tr><tr><td>Mother's Maiden Name</td><td><%=text(row.mother_last)%></td><td><%=text(row.mother_first)%></td><td><%=text(row.mother_middle)%></td><td><%=text(row.mother_contact)%></td></tr><tr><td>Legal Guardian<%if(row.guardian_relationship){%> (<%=row.guardian_relationship%>)<%}%></td><td><%=text(row.guardian_last)%></td><td><%=text(row.guardian_first)%></td><td><%=text(row.guardian_middle)%></td><td><%=text(row.guardian_contact)%></td></tr></table>
    <div class="page-label">Page 1 of 2</div>
  </section>

  <section class="sheet">
    <div class="form-title"><div class="brandline">LUNA NATIONAL HIGH SCHOOL</div><h1>BASIC EDUCATION ENROLLMENT FORM</h1><p><%=text(row.last_name)%>, <%=text(row.first_name)%> - LRN <%=text(row.lrn)%></p></div>
    <div class="section-title">5. Special Needs Education Program</div>
    <table class="grid"><tr><td colspan="2"><span class="label">Is the learner under the Special Needs Education Program?</span><div class="value boxes"><span><span class="box <%=marked(row.sne_program)%>"><%=row.sne_program?'✓':''%></span>Yes</span><span><span class="box <%=marked(!row.sne_program)%>"><%=!row.sne_program?'✓':''%></span>No</span></div></td><td colspan="2"><span class="label">Does the learner have a PWD ID?</span><div class="value boxes"><span><span class="box <%=marked(row.has_pwd_id)%>"><%=row.has_pwd_id?'✓':''%></span>Yes</span><span><span class="box <%=marked(!row.has_pwd_id)%>"><%=!row.has_pwd_id?'✓':''%></span>No</span></div></td></tr><tr><td colspan="2"><span class="label">Diagnosis / Category</span><div class="value"><%=text(row.sne_diagnosis)%><%if(row.pwd_type){%><%=row.sne_diagnosis?' / ':''%><%=row.pwd_type%><%}%></div></td><td colspan="2"><span class="label">Manifestations</span><div class="value"><%=manifestations.join(', ')%></div></td></tr></table>
    <div class="section-title">6. Returning Learner / Transfer / Move In</div>
    <table class="grid"><tr><td><span class="label">Learner Type</span><div class="value"><%=text(row.learner_type)%></div></td><td><span class="label">Last Grade Level Completed</span><div class="value"><%=text(row.last_grade_completed)%></div></td><td><span class="label">Last School Year Completed</span><div class="value"><%=text(row.last_sy_completed)%></div></td></tr><tr><td colspan="2"><span class="label">Last School Attended</span><div class="value"><%=text(row.last_school_attended||row.previous_school)%></div></td><td><span class="label">School ID</span><div class="value"><%=text(row.last_school_id)%></div></td></tr><tr><td colspan="3"><span class="label">Junior High School Graduated From</span><div class="value"><%=text(row.jhs_graduated)%></div></td></tr></table>
    <div class="section-title">7. For Learners in Senior High School</div>
    <table class="grid"><tr><td><span class="label">Semester</span><div class="value boxes"><span><span class="box <%=marked(String(row.semester).startsWith('First'))%>"><%=String(row.semester).startsWith('First')?'✓':''%></span>1st</span><span><span class="box <%=marked(String(row.semester).startsWith('Second'))%>"><%=String(row.semester).startsWith('Second')?'✓':''%></span>2nd</span></div></td><td><span class="label">Preferred Track</span><div class="value"><%=text(row.preferred_track)%></div></td></tr><tr><td><span class="label">RIASEC Recommendation</span><div class="value"><%=text(row.recommended_strand)%></div></td><td><span class="label">Final Strand</span><div class="value"><%=strand%></div></td></tr><tr><td colspan="2"><span class="label">Preferred Curriculum Exit</span><div class="value"><%=text(row.curriculum_exit)%></div></td></tr></table>
    <div class="section-title">8. Preferred Distance Learning Modalities</div>
    <table class="grid"><tr><td><div class="value boxes"><%['Blended','Modular (Print)','Online','Educational TV','Radio-Based Instruction'].forEach(mode=>{%><span><span class="box <%=marked(modes.includes(mode))%>"><%=modes.includes(mode)?'✓':''%></span><%=mode%></span><%})%></div></td></tr></table>
    <div class="section-title">Enrollment Review</div>
    <table class="grid"><tr><td><span class="label">Status</span><div class="value"><%=text(row.status)%></div></td><td><span class="label">Staff Remarks</span><div class="value"><%=text(row.remarks)%></div></td></tr><%if(row.admin_strand_override){%><tr><td><span class="label">Staff Strand Adjustment</span><div class="value"><%=row.admin_strand_override%></div></td><td><span class="label">Reason</span><div class="value"><%=text(row.admin_override_reason)%></div></td></tr><%}%></table>
    <p class="certification">I certify that the information supplied in this form is true and correct to the best of my knowledge. I authorize the Department of Education and Luna National High School to process the learner's personal information for enrollment and learner-record purposes. The information in this form shall be treated as confidential in accordance with the Data Privacy Act of 2012.</p>
    <div class="signatures"><div class="signature-line">Signature over Printed Name of Parent / Guardian</div><div class="signature-line">Date</div></div>
    <div class="signatures"><div class="signature-line">Receiving Teacher / Registrar</div><div class="signature-line">Date Received</div></div>
    <div class="page-label">Page 2 of 2</div>
  </section>
  <script nonce="<%=nonce%>">document.getElementById('printButton').addEventListener('click',()=>window.print());</script>
</body>
</html>
