<%- include('../partials/head',{title:'RIASEC Test'}) %><%- include('../partials/nav') %>
<div class="container"><div class="page-header"><div><span class="eyebrow-label">Interest assessment</span><h4>Which activities sound like you?</h4><p>There are no right answers. Choose the response that feels most natural.</p></div><span class="question-count"><i class="bi bi-ui-checks me-1"></i>42 questions</span></div><%- include('_steps',{current:2}) %>
<%if(typeof error!=='undefined'){%><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%=error%></div><%}%>
<form method="post" class="assessment-form"><div class="card"><div class="assessment-intro"><div><strong>Answer every statement</strong><small>Your answers create six RIASEC scores used for strand compatibility.</small></div><span>About 5 minutes</span></div><div class="card-body p-0"><%items.forEach((item,i)=>{%><div class="assessment-row"><span class="question-number"><%=i+1%></span><p><%=item.text%></p><div class="answer-toggle"><input class="btn-check" type="radio" id="<%=item.id%>y" name="<%=item.id%>" value="yes" required><label for="<%=item.id%>y"><i class="bi bi-check-lg"></i> Yes</label><input class="btn-check" type="radio" id="<%=item.id%>n" name="<%=item.id%>" value="no"><label for="<%=item.id%>n"><i class="bi bi-x-lg"></i> No</label></div></div><%})%></div></div><div class="form-actions"><a class="btn btn-light border" href="/enroll"><i class="bi bi-arrow-left me-1"></i>Back</a><button class="btn btn-primary">View my compatibility <i class="bi bi-arrow-right ms-1"></i></button></div></form></div><%- include('../partials/foot') %>
