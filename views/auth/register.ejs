<%- include('../partials/head',{title:'Create account'}) %><main class="auth-shell"><%- include('_brand') %><section class="auth-form-panel"><div class="auth-card"><div class="auth-card-heading"><span class="auth-mobile-mark">L</span><span class="eyebrow-label">Student registration</span><h2>Create your account</h2><p>Use an email address you can access for account recovery.</p></div><%if(typeof error!=='undefined'){%><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%=error%></div><%}%><form method="post"><div class="mb-3"><label class="form-label">Username</label><input class="form-control" name="username" placeholder="3–30 letters, numbers, or underscores" autocomplete="username" required></div><div class="mb-3"><label class="form-label">Email address</label><input class="form-control" name="email" type="email" placeholder="you@example.com" autocomplete="email" required></div><div class="row g-3"><div class="col-sm-6"><label class="form-label">Password</label><input class="form-control" name="password" type="password" autocomplete="new-password" required></div><div class="col-sm-6"><label class="form-label">Confirm password</label><input class="form-control" name="confirm" type="password" autocomplete="new-password" required></div></div><p class="password-hint"><i class="bi bi-info-circle"></i>At least 8 characters with uppercase, number, and special character.</p><button class="btn btn-primary auth-submit">Create account <i class="bi bi-arrow-right"></i></button></form><div class="auth-divider"><span>Already registered?</span></div><a class="btn btn-light border w-100" href="/login">Back to sign in</a></div></section></main></body></html>
