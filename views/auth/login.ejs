<%- include('../partials/head',{title:'Sign in'}) %><main class="auth-shell"><%- include('_brand') %><section class="auth-form-panel"><div class="auth-card"><div class="auth-card-heading"><span class="auth-mobile-mark">L</span><span class="eyebrow-label">Welcome back</span><h2>Sign in to your account</h2><p>Use the username or email connected to your enrollment account.</p></div><%if(typeof error!=='undefined'){%><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%=error%></div><%}%><%if(message){%><div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%=message%></div><%}%><form method="post"><div class="mb-3"><label class="form-label" for="identity">Username or email</label><div class="input-icon-wrap"><i class="bi bi-person input-icon"></i><input class="form-control" id="identity" name="identity" placeholder="Enter your username or email" autocomplete="username" required autofocus></div></div><div class="mb-2"><label class="form-label d-flex justify-content-between" for="password"><span>Password</span><a href="/forgot">Forgot password?</a></label><div class="input-icon-wrap"><i class="bi bi-lock input-icon"></i><input class="form-control" id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required></div></div><button class="btn btn-primary auth-submit">Sign in <i class="bi bi-arrow-right"></i></button></form><div class="auth-divider"><span>New to Luna NHS?</span></div><a class="btn btn-light border w-100" href="/register">Create a student account</a><p class="auth-support">Need help accessing your account? Contact the enrollment office.</p></div></section></main></body></html>
