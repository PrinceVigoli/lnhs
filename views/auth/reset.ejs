<%- include('../partials/head',{title:'Reset password'}) %><main class="auth-shell"><%- include('_brand') %><section class="auth-form-panel"><div class="auth-card"><div class="auth-card-heading"><span class="auth-mobile-mark">L</span><span class="eyebrow-label">Secure your account</span><h2>Choose a new password</h2><p>Use a password you have not used for this account before.</p></div><%if(!valid){%><div class="error-state"><span><i class="bi bi-link-45deg"></i></span><h3>Link unavailable</h3><p>This reset link is invalid, expired, or has already been used.</p></div><a href="/forgot" class="btn btn-primary w-100">Request another link</a><%}else{%><%if(typeof error!=='undefined'){%><div class="alert alert-danger"><%=error%></div><%}%><form method="post" action="/reset/<%=token%>"><div class="mb-3"><label class="form-label">New password</label><input class="form-control" name="password" type="password" autocomplete="new-password" required></div><div class="mb-3"><label class="form-label">Confirm new password</label><input class="form-control" name="confirm" type="password" autocomplete="new-password" required></div><p class="password-hint"><i class="bi bi-info-circle"></i>At least 8 characters with uppercase, number, and special character.</p><button class="btn btn-primary auth-submit">Update password <i class="bi bi-check-lg"></i></button></form><%}%></div></section></main></body></html>
