<%- include('../partials/head',{title:'Forgot password'}) %><main class="auth-shell"><%- include('_brand') %><section class="auth-form-panel"><div class="auth-card"><div class="auth-card-heading"><span class="auth-mobile-mark">L</span><span class="eyebrow-label">Account recovery</span><h2>Reset your password</h2><p>Enter your registered email. The reset link is valid for one hour.</p></div><%if(typeof sent!=='undefined'&&sent){%><div class="success-state"><span><i class="bi bi-envelope-check"></i></span><h3>Check your email</h3><p>If an account uses that address, we sent a password reset link.</p></div><a href="/login" class="btn btn-primary w-100">Return to sign in</a><%}else{%><form method="post"><div class="mb-4"><label class="form-label">Email address</label><div class="input-icon-wrap"><i class="bi bi-envelope input-icon"></i><input class="form-control" type="email" name="email" placeholder="you@example.com" required autofocus></div></div><button class="btn btn-primary auth-submit">Send reset link <i class="bi bi-arrow-right"></i></button></form><a href="/login" class="auth-back"><i class="bi bi-arrow-left"></i>Back to sign in</a><%}%></div></section></main></body></html>
