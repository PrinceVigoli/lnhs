<%- include('../partials/head',{title:'Documents'}) %><%- include('../partials/nav') %><div class="container py-4"><div class="page-header"><div><h4><i class="bi bi-folder2-open me-2"></i>My Documents</h4><p class="text-muted mb-0">Upload clear PDF or image files, up to 5 MB each</p></div></div><div class="row g-4"><div class="col-lg-5"><div class="card"><div class="card-section-header"><i class="bi bi-cloud-arrow-up text-primary"></i>Upload Document</div><div class="card-body"><form method="post" action="/documents" enctype="multipart/form-data"><div class="mb-3"><label class="form-label">Requirement</label><select class="form-select" name="requirement_id" required><option value="">Choose…</option><%requirements.forEach(r=>{%><option value="<%=r.id%>"><%=r.name%><%=r.is_required?' *':''%></option><%})%></select></div><div class="mb-3"><label class="form-label">File</label><input class="form-control" type="file" name="document" accept=".jpg,.jpeg,.png,.gif,.webp,.pdf" required></div><button class="btn btn-primary w-100">Upload for Review</button></form></div></div></div><div class="col-lg-7"><div class="card"><div class="card-section-header"><i class="bi bi-files text-primary"></i>Submitted Documents</div><%if(!documents.length){%><div class="text-center text-muted py-5">No documents uploaded yet.</div><%}else{%><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Requirement</th><th>File</th><th>Status</th><th></th></tr></thead><tbody><%documents.forEach(d=>{%><tr><td><%=d.requirement%></td><td><%=d.original_name%></td><td><span class="status-badge status-<%=d.status%>"><%=d.status%></span><%if(d.admin_note){%><small class="d-block text-muted"><%=d.admin_note%></small><%}%></td><td><a class="btn btn-outline-secondary btn-sm" href="/documents/<%=d.id%>/download" target="_blank"><i class="bi bi-eye"></i></a></td></tr><%})%></tbody></table></div><%}%></div></div></div></div><%- include('../partials/foot') %>
