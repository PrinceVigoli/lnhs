<%- include('../partials/head',{title:'Overview'}) %><%- include('../partials/nav') %><%const latest=enrollments[0]; const profileReady=student&&student.first_name&&student.last_name&&student.birth_date; const nextHref=!profileReady?'/profile':!latest?'/enroll':'/result/'+latest.id; const nextLabel=!profileReady?'Complete learner profile':!latest?'Start enrollment':'View application';%>
<div class="dashboard-hero"><div class="hero-content"><span class="hero-kicker">Learner workspace</span><h1><%=profileReady?'Good to see you, '+student.first_name+'.':'Welcome, '+user.username+'.'%></h1><p><%=!profileReady?'Complete your learner information to unlock the enrollment form.':!latest?'Your profile is ready. Take the RIASEC assessment to begin your application.':'Your application is '+latest.status.toLowerCase()+'. You can review its details and print forms anytime.'%></p><a class="btn hero-cta" href="<%=nextHref%>"><%=nextLabel%><i class="bi bi-arrow-right"></i></a></div><div class="hero-status"><span>Enrollment status</span><strong><%=latest?latest.status:'Not started'%></strong><small><%=latest?'S.Y. '+latest.school_year:'Your next step appears on the left.'%></small></div></div>
<div class="container-fluid"><div class="dashboard-grid"><section><div class="section-title"><div><h2>Your enrollment journey</h2><p>Complete each stage in order.</p></div><span><%=latest?'Application active':profileReady?'Ready to apply':'1 step remaining'%></span></div><div class="journey-grid"><a class="journey-card <%=profileReady?'complete':'current'%>" href="/profile"><span class="journey-icon"><i class="bi <%=profileReady?'bi-check-lg':'bi-person-vcard'%>"></i></span><span><small>Step 1</small><strong>Learner profile</strong><em><%=profileReady?'Completed':'Action needed'%></em></span></a><a class="journey-card <%=latest?'complete':profileReady?'current':''%>" href="/enroll"><span class="journey-icon"><i class="bi <%=latest?'bi-check-lg':'bi-compass'%>"></i></span><span><small>Step 2</small><strong>RIASEC & strand</strong><em><%=latest?'Completed':profileReady?'Ready':'Locked'%></em></span></a><a class="journey-card <%=latest?'current':''%>" href="<%=latest?'/result/'+latest.id:'#'%>"><span class="journey-icon"><i class="bi bi-journal-check"></i></span><span><small>Step 3</small><strong>Application review</strong><em><%=latest?latest.status:'Not started'%></em></span></a></div>
<div class="card mt-4"><div class="card-section-header"><i class="bi bi-clock-history"></i><span>Application history</span><a href="/enroll" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg me-1"></i>New application</a></div><%if(!enrollments.length){%><div class="empty-state"><span><i class="bi bi-journal-plus"></i></span><h3>No applications yet</h3><p>Your first application will appear here after you complete the enrollment flow.</p><a href="/enroll" class="btn btn-primary">Start enrollment</a></div><%}else{%><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Reference</th><th>School year</th><th>Grade</th><th>Recommended</th><th>Chosen</th><th>Status</th><th></th></tr></thead><tbody><%enrollments.forEach(e=>{%><tr><td class="fw-semibold">#<%=String(e.id).padStart(6,'0')%></td><td><%=e.school_year%></td><td>Grade <%=e.grade_level%></td><td><span class="strand-badge strand-<%=e.recommended_strand%>"><%=e.recommended_strand%></span></td><td><span class="strand-badge strand-<%=e.chosen_strand%>"><%=e.chosen_strand%></span></td><td><span class="status-badge status-<%=e.status%>"><%=e.status%></span></td><td><a class="row-action" href="/result/<%=e.id%>" aria-label="View application"><i class="bi bi-chevron-right"></i></a></td></tr><%})%></tbody></table></div><%}%></div></section>
<aside><div class="side-card"><span class="side-card-label">Quick access</span><a href="/documents"><i class="bi bi-folder2-open"></i><span><strong>Documents</strong><small>Upload and track requirements</small></span><i class="bi bi-chevron-right"></i></a><a href="/notifications"><i class="bi bi-bell"></i><span><strong>Notifications</strong><small>Review staff updates</small></span><i class="bi bi-chevron-right"></i></a><a href="/profile"><i class="bi bi-person-lines-fill"></i><span><strong>Profile</strong><small>Update learner information</small></span><i class="bi bi-chevron-right"></i></a></div><div class="help-card"><i class="bi bi-chat-heart"></i><h3>Need guidance?</h3><p>Talk to your adviser or registrar before choosing a strand if you are unsure.</p></div></aside></div></div><%- include('../partials/foot') %>
