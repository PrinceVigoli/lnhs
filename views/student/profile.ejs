<%- include('../partials/head',{title:'Student Profile'}) %><%- include('../partials/nav') %><%const value=k=>student[k]??''; const checked=k=>student[k]?'checked':'';%>
<div class="container py-4"><div class="page-header"><div><h4><i class="bi bi-person-badge me-2"></i>Student Profile</h4><p class="text-muted mb-0">Information used in enrollment and printable forms</p></div></div><form method="post">
<div class="card mb-4"><div class="card-section-header"><i class="bi bi-person text-primary"></i>Learner Information</div><div class="card-body row g-3"><%[['lrn','LRN'],['psa_birth_cert_no','PSA Birth Certificate No.'],['first_name','First Name'],['middle_name','Middle Name'],['last_name','Last Name'],['extension_name','Extension Name'],['birth_date','Birth Date','date'],['gender','Gender'],['place_of_birth','Place of Birth'],['nationality','Nationality'],['religion','Religion'],['mother_tongue','Mother Tongue'],['contact_number','Contact Number']].forEach(f=>{%><div class="col-md-4"><label class="form-label"><%=f[1]%></label><input class="form-control" name="<%=f[0]%>" type="<%=f[2]||'text'%>" value="<%=value(f[0])?String(value(f[0])).slice(0,f[2]==='date'?10:999):''%>" <%=['first_name','last_name'].includes(f[0])?'required':''%>></div><%})%><div class="col-md-3"><label class="form-check mt-4"><input class="form-check-input" type="checkbox" name="is_4ps" <%=checked('is_4ps')%>> <span class="form-check-label">4Ps beneficiary</span></label></div><div class="col-md-3"><label class="form-label">4Ps Household ID</label><input class="form-control" name="fourps_household_id" value="<%=value('fourps_household_id')%>"></div><div class="col-md-3"><label class="form-check mt-4"><input class="form-check-input" type="checkbox" name="is_ip" <%=checked('is_ip')%>> <span class="form-check-label">IP community</span></label></div><div class="col-md-3"><label class="form-label">IP Community</label><input class="form-control" name="ip_community" value="<%=value('ip_community')%>"></div></div></div>
<div class="card mb-4"><div class="card-section-header"><i class="bi bi-geo-alt text-primary"></i>Current and Permanent Address</div><div class="card-body"><h6>Current Address</h6><div class="row g-3"><%[['cur_house_no','House No.'],['cur_street','Street'],['cur_barangay','Barangay'],['cur_municipality','Municipality/City'],['cur_province','Province'],['cur_country','Country'],['cur_zip','ZIP Code']].forEach(f=>{%><div class="col-md-4"><label class="form-label"><%=f[1]%></label><input class="form-control" name="<%=f[0]%>" value="<%=value(f[0])%>"></div><%})%><div class="col-12"><label class="form-label">Full Address (fallback)</label><textarea class="form-control" name="address"><%=value('address')%></textarea></div></div><hr><label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="perm_same_as_current" <%=checked('perm_same_as_current')%>> <span class="form-check-label">Permanent address is the same as current address</span></label><h6>Permanent Address</h6><div class="row g-3"><%[['perm_house_no','House No.'],['perm_street','Street'],['perm_barangay','Barangay'],['perm_municipality','Municipality/City'],['perm_province','Province'],['perm_country','Country'],['perm_zip','ZIP Code']].forEach(f=>{%><div class="col-md-4"><label class="form-label"><%=f[1]%></label><input class="form-control" name="<%=f[0]%>" value="<%=value(f[0])%>"></div><%})%></div></div></div>
<div class="card mb-4"><div class="card-section-header"><i class="bi bi-people text-primary"></i>Parents and Guardian</div><div class="card-body"><%[['father','Father'],['mother','Mother'],['guardian','Guardian']].forEach(p=>{%><h6><%=p[1]%></h6><div class="row g-3 mb-3"><%[['last','Last Name'],['first','First Name'],['middle','Middle Name'],['contact','Contact']].forEach(f=>{%><div class="col-md-3"><label class="form-label"><%=f[1]%></label><input class="form-control" name="<%=p[0]+'_'+f[0]%>" value="<%=value(p[0]+'_'+f[0])%>"></div><%})%><%if(p[0]==='guardian'){%><div class="col-md-3"><label class="form-label">Relationship</label><input class="form-control" name="guardian_relationship" value="<%=value('guardian_relationship')%>"></div><%}%></div><%})%></div></div>
<div class="card mb-4"><div class="card-section-header"><i class="bi bi-universal-access text-primary"></i>Special Needs Education</div><div class="card-body row g-3"><div class="col-md-4"><label class="form-check mt-4"><input class="form-check-input" type="checkbox" name="sne_program" <%=checked('sne_program')%>> <span class="form-check-label">Applying for SNE program</span></label></div><div class="col-md-8"><label class="form-label">Diagnosis / Category</label><input class="form-control" name="sne_diagnosis" value="<%=value('sne_diagnosis')%>"></div><div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="is_pwd" <%=checked('is_pwd')%>> <span class="form-check-label">Learner with disability</span></label></div><div class="col-md-4"><label class="form-label">Disability Type</label><input class="form-control" name="pwd_type" value="<%=value('pwd_type')%>"></div><div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="has_pwd_id" <%=checked('has_pwd_id')%>> <span class="form-check-label">Has PWD ID</span></label></div><div class="col-12"><label class="form-label d-block">Manifestations</label><%const savedManifest=Array.isArray(student.sne_manifestations)?student.sne_manifestations:[]; ['Difficulty seeing','Difficulty hearing','Difficulty walking','Difficulty remembering','Difficulty communicating'].forEach(m=>{%><label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="sne_manifestations" value="<%=m%>" <%=savedManifest.includes(m)?'checked':''%>> <span class="form-check-label"><%=m%></span></label><%})%></div></div></div>
<div class="card mb-4"><div class="card-section-header"><i class="bi bi-mortarboard text-primary"></i>School Background</div><div class="card-body row g-3"><%[['learner_type','Learner Type'],['previous_school','Previous School'],['jhs_graduated','JHS Graduated From'],['last_grade_completed','Last Grade Completed'],['last_sy_completed','Last School Year Completed'],['last_school_attended','Last School Attended'],['last_school_id','Last School ID'],['grade_level','Incoming Grade Level'],['semester','Semester']].forEach(f=>{%><div class="col-md-4"><label class="form-label"><%=f[1]%></label><input class="form-control" name="<%=f[0]%>" value="<%=value(f[0])%>"></div><%})%><div class="col-12"><label class="form-label d-block">Preferred Distance Learning Modalities</label><%const savedModes=Array.isArray(student.dl_modalities)?student.dl_modalities:[]; ['Modular (Print)','Online','Educational TV','Radio-Based Instruction','Blended'].forEach(m=>{%><label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="dl_modalities" value="<%=m%>" <%=savedModes.includes(m)?'checked':''%>> <span class="form-check-label"><%=m%></span></label><%})%></div></div></div>
<div class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/dashboard">Cancel</a><button class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Save Profile</button></div></form></div><%- include('../partials/foot') %>
