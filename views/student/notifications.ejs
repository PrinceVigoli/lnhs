<%- include('../partials/head',{title:'Notifications'}) %><%- include('../partials/nav') %><div class="container py-4"><div class="page-header"><h4><i class="bi bi-bell me-2"></i>Notifications</h4><form method="post" action="/notifications/read"><button class="btn btn-outline-primary btn-sm">Mark All Read</button></form></div><div class="card"><div class="list-group list-group-flush"><%if(!notifications.length){%><div class="text-center text-muted py-5">No notifications.</div><%}notifications.forEach(n=>{%><div class="list-group-item p-3 <%=n.is_read?'':'bg-blue-soft'%>"><div class="d-flex justify-content-between"><strong><%=n.title%></strong><small class="text-muted"><%=new Date(n.created_at).toLocaleString()%></small></div><div class="small mt-1"><%=n.message%></div></div><%})%></div></div></div><%- include('../partials/foot') %>
