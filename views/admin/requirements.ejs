<%- include('../partials/head',{title:'Requirements'}) %><%- include('../partials/nav') %><div class="container-fluid py-4 px-4"><div class="page-header"><h4><i class="bi bi-list-check me-2"></i>Document Requirements</h4></div><div class="row g-4"><div class="col-lg-4"><div class="card"><div class="card-section-header">Add Requirement</div><div class="card-body"><form method="post"><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" required></div><div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description"></textarea></div><label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="is_required" checked> <span class="form-check-label">Required</span></label><button class="btn btn-primary w-100">Add Requirement</button></form></div></div></div><div class="col-lg-8"><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Description</th><th>Required</th><th>Status</th><th></th></tr></thead><tbody><%requirements.forEach(r=>{%><tr><td><strong><%=r.name%></strong></td><td><%=r.description||'—'%></td><td><%=r.is_required?'Yes':'No'%></td><td><span class="badge <%=r.is_active?'bg-success':'bg-secondary'%>"><%=r.is_active?'Active':'Inactive'%></span></td><td><form method="post" action="/admin/requirements/<%=r.id%>/toggle"><button class="btn btn-outline-secondary btn-sm"><%=r.is_active?'Disable':'Enable'%></button></form></td></tr><%})%></tbody></table></div></div></div></div></div><%- include('../partials/foot') %>
