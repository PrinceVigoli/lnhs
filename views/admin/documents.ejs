<%- include('../partials/head',{title:'Documents'}) %><%- include('../partials/nav') %><div class="container-fluid py-4 px-4"><div class="page-header"><h4><i class="bi bi-folder2-open me-2"></i>Document Review</h4></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Student</th><th>Requirement / File</th><th>Submitted</th><th>Review</th></tr></thead><tbody><%if(!documents.length){%><tr><td colspan="4" class="text-center text-muted py-5">No submitted documents.</td></tr><%}documents.forEach(d=>{%><tr><td><strong><%=d.first_name%> <%=d.last_name%></strong></td><td><%=d.requirement%><small class="d-block"><a href="/documents/<%=d.id%>/download" target="_blank"><%=d.original_name%></a></small></td><td><%=new Date(d.created_at).toLocaleDateString()%></td><td><form method="post" action="/admin/documents/<%=d.id%>/status" class="d-flex gap-2"><select class="form-select form-select-sm" name="status" style="width:auto"><%['Submitted','Verified','Rejected'].forEach(s=>{%><option <%=s===d.status?'selected':''%>><%=s%></option><%})%></select><input class="form-control form-control-sm" name="admin_note" placeholder="Review note" value="<%=d.admin_note||''%>"><button class="btn btn-primary btn-sm">Save</button></form></td></tr><%})%></tbody></table></div></div></div><%- include('../partials/foot') %>
