<%- include('../partials/head',{title:'Staff Overview'}) %><%- include('../partials/nav') %>
<div class="container-fluid"><div class="page-header"><div><span class="eyebrow-label">Enrollment operations</span><h4>Good day, <%=user.username%></h4><p>Monitor applications and focus on items that need staff attention.</p></div><div class="header-actions"><a class="btn btn-light border" href="/admin/students"><i class="bi bi-people me-1"></i>Students</a><a class="btn btn-primary" href="/admin/enrollments"><i class="bi bi-journal-check me-1"></i>Review applications</a></div></div>
<div class="metrics-grid"><div class="metric-card"><span class="metric-icon blue"><i class="bi bi-people"></i></span><div><small>Registered learners</small><strong><%=students.total%></strong><em>All student accounts</em></div></div><div class="metric-card"><span class="metric-icon indigo"><i class="bi bi-journal-text"></i></span><div><small>Total applications</small><strong><%=stats.enrollments||0%></strong><em>Across all school years</em></div></div><div class="metric-card attention"><span class="metric-icon amber"><i class="bi bi-hourglass-split"></i></span><div><small>Awaiting review</small><strong><%=stats.pending||0%></strong><em>Requires staff action</em></div></div><div class="metric-card"><span class="metric-icon green"><i class="bi bi-check2-circle"></i></span><div><small>Confirmed</small><strong><%=stats.confirmed||0%></strong><em>Completed enrollments</em></div></div></div>
<div class="admin-dashboard-grid"><div class="card"><div class="card-section-header"><i class="bi bi-clock-history"></i><span>Recent applications</span><a class="section-link ms-auto" href="/admin/enrollments">View all <i class="bi bi-arrow-right"></i></a></div><%if(!recent.length){%><div class="empty-state compact"><span><i class="bi bi-inbox"></i></span><h3>No applications yet</h3><p>New student submissions will appear here.</p></div><%}else{%><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Learner</th><th>School year</th><th>Strand</th><th>Status</th><th>Submitted</th></tr></thead><tbody><%recent.forEach(e=>{%><tr><td><span class="table-person"><span><%=((e.first_name||'?')[0]).toUpperCase()%></span><strong><%=e.first_name%> <%=e.last_name%></strong></span></td><td><%=e.school_year%></td><td><span class="strand-badge strand-<%=e.chosen_strand%>"><%=e.chosen_strand%></span></td><td><span class="status-badge status-<%=e.status%>"><%=e.status%></span></td><td><%=new Date(e.created_at).toLocaleDateString()%></td></tr><%})%></tbody></table></div><%}%></div><aside class="operations-panel"><h3>Operations</h3><p>Common staff tasks</p><a href="/admin/enrollments"><span><i class="bi bi-journal-check"></i></span><div><strong>Review enrollments</strong><small>Confirm, return, or reject</small></div><i class="bi bi-chevron-right"></i></a><a href="/admin/documents"><span><i class="bi bi-file-earmark-check"></i></span><div><strong>Verify documents</strong><small>Review learner uploads</small></div><i class="bi bi-chevron-right"></i></a><a href="/admin/requirements"><span><i class="bi bi-list-check"></i></span><div><strong>Manage requirements</strong><small>Configure the checklist</small></div><i class="bi bi-chevron-right"></i></a></aside></div></div><%- include('../partials/foot') %>
