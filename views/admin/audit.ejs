<%- include('../partials/head',{title:'Audit Logs'}) %><%- include('../partials/nav') %><div class="container-fluid py-4 px-4"><div class="page-header"><h4><i class="bi bi-clipboard2-data me-2"></i>Audit Logs</h4></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead><tbody><%logs.forEach(l=>{%><tr><td><%=new Date(l.created_at).toLocaleString()%></td><td><%=l.username||'System'%></td><td><%=l.action%></td><td><%=l.entity_type||'—'%> <%=l.entity_id||''%></td><td><code><%=typeof l.details==='string'?l.details:JSON.stringify(l.details)%></code></td></tr><%})%></tbody></table></div></div></div><%- include('../partials/foot') %>
