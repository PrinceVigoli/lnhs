<%- include('../partials/head',{title:'Users'}) %><%- include('../partials/nav') %><div class="container-fluid py-4 px-4"><div class="page-header"><h4><i class="bi bi-person-gear me-2"></i>User Management</h4></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Created</th><th></th></tr></thead><tbody><%users.forEach(u=>{%><tr><td><strong><%=u.username%></strong></td><td><%=u.email%></td><td><span class="role-badge role-<%=u.role%>"><%=u.role%></span></td><td><%=new Date(u.created_at).toLocaleDateString()%></td><td><%if(u.id!==user.id){%><form class="d-flex gap-2" method="post" action="/admin/users/<%=u.id%>/role"><select class="form-select form-select-sm" name="role"><%['student','teacher','registrar','admin'].forEach(role=>{%><option <%=role===u.role?'selected':''%>><%=role%></option><%})%></select><button class="btn btn-primary btn-sm">Save</button></form><%}%></td></tr><%})%></tbody></table></div></div></div><%- include('../partials/foot') %>
